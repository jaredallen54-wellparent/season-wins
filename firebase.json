{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "_site",
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": { "database": { "port": 9000 }, "ui": { "enabled": false } }
}
