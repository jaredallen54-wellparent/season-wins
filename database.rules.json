{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": true,
      ".write": "newData.parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
      "lockAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "lines": {
      ".read": true,
      ".write": "newData.parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
      "$team": {
        ".validate": "$team.matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.isNumber() && newData.val() > 0 && newData.val() < 82 && newData.val() % 1 === 0.5"
      }
    },
    "manualStandings": {
      ".read": true,
      ".write": "newData.parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
      "updatedAt": {
        ".validate": "newData.val() === now"
      },
      "teams": {
        "$team": {
          ".validate": "$team.matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.hasChildren(['w', 'l'])",
          "w": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 82 && newData.val() % 1 === 0"
          },
          "l": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 82 && newData.val() % 1 === 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "players": {
      ".read": true,
      "$pid": {
        ".write": "(!data.exists() && newData.exists() && ((root.child('config/lockAt').exists() && now < root.child('config/lockAt').val()) || (!root.child('config/lockAt').exists() && now < 1792522500000))) || newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        ".validate": "$pid.matches(/^p[a-z0-9]{10,24}$/) && newData.hasChildren(['name', 'joinedAt']) && newData.parent().parent().child('secrets').child($pid).exists()",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24 && newData.val().matches(/^[A-Za-z0-9]+([ '_.-][A-Za-z0-9]+)*$/) && newData.parent().parent().parent().child('names').child(newData.val().toLowerCase()).val() === $pid"
        },
        "joinedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "names": {
      ".read": true,
      "$key": {
        ".write": "(!data.exists() && newData.exists() && ((root.child('config/lockAt').exists() && now < root.child('config/lockAt').val()) || (!root.child('config/lockAt').exists() && now < 1792522500000))) || newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        ".validate": "newData.isString() && newData.parent().parent().child('players').child(newData.val()).child('name').val().toLowerCase() === $key"
      }
    },
    "secrets": {
      "$pid": {
        ".write": "(!data.exists() && newData.exists() && ($pid === 'admin' || (!root.child('players').child($pid).exists() && newData.parent().parent().child('players').child($pid).child('name').exists()))) || newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
      }
    },
    "proofs": {
      "$pid": {
        ".write": "newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        "$hash": {
          ".write": "newData.exists()",
          ".validate": "$hash === root.child('secrets').child($pid).val() && newData.val() === now"
        }
      }
    },
    "locks": {
      ".read": true,
      "$pid": {
        ".write": "(((root.child('config/lockAt').exists() && now < root.child('config/lockAt').val()) || (!root.child('config/lockAt').exists() && now < 1792522500000)) && root.child('players').child($pid).exists() && newData.parent().parent().child('proofs').child($pid).child(root.child('secrets').child($pid).val()).val() === now) || newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        "a": {
          ".validate": "newData.isString() && newData.val().matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.parent().parent().parent().child('picks').child($pid).child(newData.val()).exists() && newData.parent().child('b').val() !== newData.val() && newData.parent().child('c').val() !== newData.val()"
        },
        "b": {
          ".validate": "newData.isString() && newData.val().matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.parent().parent().parent().child('picks').child($pid).child(newData.val()).exists() && newData.parent().child('a').val() !== newData.val() && newData.parent().child('c').val() !== newData.val()"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.parent().parent().parent().child('picks').child($pid).child(newData.val()).exists() && newData.parent().child('a').val() !== newData.val() && newData.parent().child('b').val() !== newData.val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "picks": {
      ".read": true,
      "$pid": {
        ".write": "(((root.child('config/lockAt').exists() && now < root.child('config/lockAt').val()) || (!root.child('config/lockAt').exists() && now < 1792522500000)) && root.child('players').child($pid).exists() && newData.parent().parent().child('proofs').child($pid).child(root.child('secrets').child($pid).val()).val() === now) || newData.parent().parent().child('proofs').child('admin').child(root.child('secrets').child('admin').val()).val() === now",
        "$team": {
          ".validate": "$team.matches(/^(ATL|BOS|BKN|CHA|CHI|CLE|DET|IND|MIA|MIL|NYK|ORL|PHI|TOR|WAS|DAL|DEN|GSW|HOU|LAC|LAL|MEM|MIN|NOP|OKC|PHX|POR|SAC|SAS|UTA)$/) && newData.isString() && (newData.val() === 'O' || newData.val() === 'U')"
        }
      }
    }
  }
}
